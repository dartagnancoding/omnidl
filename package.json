{
  "name": "omnidl",
  "version": "0.1.0",
  "description": "Media download CLI — orchestration layer over yt-dlp and gallery-dl",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dartagnancoding/omnidl.git"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "omnidl": "dist/cli/index.js"
  },
  "files": [
